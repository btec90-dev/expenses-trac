{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "accountId": { "type": "string" },
        "categoryId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "payee": { "type": "string" },
        "note": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "date", "amount", "currency", "accountId", "categoryId", "type", "userId"]
    },
    "Account": {
      "title": "Account",
      "description": "Financial account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "icon": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "type", "icon", "userId"]
    },
    "Category": {
      "title": "Category",
      "description": "Transaction category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "icon", "color", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User transactions"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "Account",
      "description": "User accounts"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "User categories"
    }
  }
}
