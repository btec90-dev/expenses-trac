<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>Balatec Secure Wallet</title>
<style>
  :root {
    --font-inter: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-jakarta: 'Plus Jakarta Sans', 'Avenir Next', 'Segoe UI', sans-serif;
    --font-outfit: 'Outfit', 'Trebuchet MS', 'Segoe UI', sans-serif;
    --font-lora: 'Lora', Georgia, 'Times New Roman', serif;
    --font-playfair: 'Playfair Display', Baskerville, 'Palatino Linotype', serif;
    --font-mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;

    --active-font: var(--font-inter);

    /* Default Theme: White Leather */
    --bg-chassis: #e9e4dc;
    --bg-app: #faf7f2;
    --bg-card: #ffffff;
    --bg-card-alt: #f3ede4;
    --bg-header: #fdfbf7;
    --stitch-color: rgba(168, 130, 88, 0.45);
    --border-leather: #dfd5c7;
    --accent: #9c6635;
    --accent-soft: rgba(156, 102, 53, 0.12);
    --accent-text: #ffffff;
    --text-main: #231d18;
    --text-muted: #75685a;
    --nav-bg: #ffffff;
    --nav-active: #9c6635;
    --input-bg: #f6f1ea;
    --success: #1b7a43;
    --danger: #c0392b;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
  }

  html, body {
    width: 100%;
    height: 100%;
    background: var(--bg-chassis);
    font-family: var(--active-font);
    color: var(--text-main);
    overflow: hidden;
  }

  /* Adaptive Mobile + Desktop Shell */
  .wallet-chassis {
    width: 100%;
    height: 100dvh;
    background: var(--bg-app);
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Desktop Layout (>= 860px): Left Sidebar + Wide Workspace */
  @media (min-width: 860px) {
    .wallet-chassis {
      display: grid;
      grid-template-columns: 260px 1fr;
      grid-template-rows: 68px 1fr;
      max-width: 1440px;
      margin: 0 auto;
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.14);
      border-left: 1px solid var(--border-leather);
      border-right: 1px solid var(--border-leather);
    }

    .top-bar {
      grid-column: 1 / -1;
      grid-row: 1;
      padding: 12px 28px;
    }

    .bottom-nav {
      grid-column: 1;
      grid-row: 2;
      position: static !important;
      height: auto !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-start !important;
      align-items: stretch !important;
      gap: 6px;
      padding: 20px 14px !important;
      border-top: none !important;
      border-right: 1px solid var(--border-leather);
    }

    .nav-btn {
      flex-direction: row !important;
      justify-content: flex-start !important;
      gap: 12px !important;
      padding: 12px 14px !important;
      border-radius: 14px;
      font-size: 13px !important;
      text-align: left;
      transition: background 0.15s ease;
    }

    .nav-btn:hover {
      background: var(--accent-soft);
    }

    .nav-btn.active {
      background: var(--accent-soft);
    }

    .nav-btn.center-home {
      top: 0 !important;
      order: -1; /* Places Ledger Home at the top of the desktop sidebar */
    }

    .nav-btn.center-home .nav-circle {
      width: 32px !important;
      height: 32px !important;
      border-radius: 10px !important;
      box-shadow: none !important;
      border: none !important;
    }

    .main-scroll {
      grid-column: 2;
      grid-row: 2;
      padding: 24px 32px 100px !important;
    }

    .fab-add {
      right: 32px !important;
      bottom: 28px !important;
      width: auto !important;
      padding: 0 22px;
      gap: 8px;
      font-size: 15px !important;
    }

    .fab-label {
      display: inline !important;
    }
  }

  .fab-label {
    display: none;
    font-weight: 800;
    font-size: 13px;
  }

  /* Saddle-Stitched Card Utility */
  .leather-card {
    background: var(--bg-card);
    border: 1px solid var(--border-leather);
    border-radius: 18px;
    position: relative;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
  }

  .leather-card::after {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px dashed var(--stitch-color);
    border-radius: 14px;
    pointer-events: none;
  }

  .leather-card-inner {
    position: relative;
    z-index: 1;
  }

  /* Top App Bar */
  .top-bar {
    background: var(--bg-header);
    padding: calc(10px + env(safe-area-inset-top)) 16px 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-leather);
    position: relative;
    z-index: 10;
    flex-shrink: 0;
  }

  .top-bar::after {
    content: "";
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 3px;
    border-bottom: 1px dashed var(--stitch-color);
    pointer-events: none;
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-title {
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 0.06em;
    color: var(--text-main);
    line-height: 1.1;
  }

  .brand-sub {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .top-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pill-btn {
    background: var(--bg-card-alt);
    color: var(--text-main);
    border: 1px solid var(--border-leather);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: transform 0.12s ease, opacity 0.15s ease;
  }

  .pill-btn:hover {
    opacity: 0.9;
  }

  .pill-btn:active {
    transform: scale(0.95);
  }

  .pill-btn.accent {
    background: var(--accent);
    color: var(--accent-text);
    border-color: var(--accent);
  }

  /* Main Scrollable Viewport */
  .main-scroll {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 14px 14px calc(94px + env(safe-area-inset-bottom));
    scrollbar-width: thin;
  }

  .content-container {
    max-width: 1040px;
    margin: 0 auto;
    width: 100%;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 16px 2px 10px;
  }

  .section-title {
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  /* Hero Balance Banner */
  .hero-banner {
    background: linear-gradient(145deg, var(--accent), #3d2410);
    color: #ffffff;
    border-radius: 20px;
    padding: 18px 20px;
    position: relative;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.15);
    margin-bottom: 14px;
  }

  .hero-banner::after {
    content: "";
    position: absolute;
    inset: 5px;
    border: 1px dashed rgba(255, 232, 200, 0.45);
    border-radius: 15px;
    pointer-events: none;
  }

  @media (min-width: 720px) {
    .hero-flex {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
    .hero-stats {
      min-width: 320px;
    }
  }

  .hero-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.85;
    font-weight: 600;
  }

  .hero-amount {
    font-size: clamp(26px, 4vw, 34px);
    font-weight: 800;
    margin: 4px 0 12px;
    letter-spacing: -0.02em;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .hero-stat-box {
    background: rgba(255, 255, 255, 0.13);
    border-radius: 12px;
    padding: 10px 12px;
  }

  .hero-stat-label {
    font-size: 10px;
    opacity: 0.85;
    text-transform: uppercase;
  }

  .hero-stat-val {
    font-size: 15px;
    font-weight: 700;
    margin-top: 2px;
  }

  /* Inputs & Responsive Filter Bar */
  .input-field, .select-field {
    width: 100%;
    background: var(--input-bg);
    color: var(--text-main);
    border: 1px solid var(--border-leather);
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 14px; /* Prevents iOS auto-zoom on focus */
    font-family: inherit;
    outline: none;
  }

  .input-field:focus, .select-field:focus {
    border-color: var(--accent);
  }

  .filter-bar {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .filter-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  @media (min-width: 720px) {
    .filter-bar {
      grid-template-columns: 1.5fr 1fr;
      align-items: center;
    }
  }

  /* Transaction Item */
  .tx-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tx-item {
    background: var(--bg-card);
    border: 1px solid var(--border-leather);
    border-radius: 14px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    transition: border-color 0.15s ease;
  }

  .tx-item:hover {
    border-color: var(--accent);
  }

  .tx-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .tx-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--bg-card-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 19px;
    flex-shrink: 0;
  }

  .tx-info {
    min-width: 0;
  }

  .tx-title {
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tx-meta {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tx-right {
    text-align: right;
    flex-shrink: 0;
  }

  .tx-amount {
    font-size: 14px;
    font-weight: 800;
  }

  .tx-amount.income { color: var(--success); }
  .tx-amount.expense { color: var(--danger); }

  .tx-del {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 11px;
    cursor: pointer;
    margin-top: 3px;
    text-decoration: underline;
  }

  /* Responsive Grids (2 cols on mobile, 3-4 cols on desktop) */
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .responsive-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  @media (min-width: 640px) {
    .responsive-cards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
  }

  @media (min-width: 1024px) {
    .responsive-cards-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .settings-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      align-items: start;
    }
  }

  .account-card {
    padding: 14px;
    transition: transform 0.12s ease;
  }

  .account-card:hover {
    transform: translateY(-2px);
  }

  .acc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .acc-icon {
    font-size: 22px;
  }

  .acc-badge {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 2px 6px;
    border-radius: 6px;
  }

  .acc-name {
    font-size: 13px;
    font-weight: 700;
  }

  .acc-bal {
    font-size: 16px;
    font-weight: 800;
    margin-top: 4px;
  }

  .cat-card {
    padding: 14px;
    cursor: pointer;
    transition: transform 0.12s ease;
  }

  .cat-card:hover {
    transform: translateY(-2px);
  }

  .cat-card:active {
    transform: scale(0.97);
  }

  /* Bottom Navigation on Mobile (Ledger Centered Startup Home) */
  .bottom-nav {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: calc(70px + env(safe-area-inset-bottom));
    background: var(--nav-bg);
    border-top: 1px solid var(--border-leather);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: center;
    padding: 4px 6px calc(8px + env(safe-area-inset-bottom));
    z-index: 20;
  }

  .nav-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    font-size: 10px;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    padding: 4px 2px;
  }

  .nav-btn.active {
    color: var(--nav-active);
  }

  .nav-btn.center-home {
    position: relative;
    top: -10px;
  }

  .nav-btn.center-home .nav-circle {
    width: 48px;
    height: 48px;
    border-radius: 16px;
    background: var(--accent);
    color: var(--accent-text);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.22);
    border: 2px solid var(--bg-card);
  }

  .nav-btn.center-home.active .nav-circle {
    transform: scale(1.06);
  }

  /* Floating Add Transaction Button */
  .fab-add {
    position: absolute;
    right: 16px;
    bottom: calc(82px + env(safe-area-inset-bottom));
    width: 54px;
    height: 54px;
    border-radius: 18px;
    background: var(--accent);
    color: var(--accent-text);
    border: 2px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    font-size: 26px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 19;
    transition: transform 0.12s ease;
  }

  .fab-add:active {
    transform: scale(0.94);
  }

  /* Responsive Modal Overlay (Bottom Sheet on Mobile, Centered Dialog on Desktop) */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 12, 10, 0.62);
    display: none;
    align-items: flex-end;
    justify-content: center;
    z-index: 50;
    padding: 12px;
  }

  @media (min-width: 640px) {
    .modal-backdrop {
      align-items: center;
      padding: 24px;
    }
  }

  .modal-backdrop.open {
    display: flex;
  }

  .modal-sheet {
    width: 100%;
    max-width: 500px;
    max-height: 90dvh;
    overflow-y: auto;
    background: var(--bg-card);
    border: 1px solid var(--border-leather);
    border-radius: 22px;
    padding: 18px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }

  .modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .modal-title {
    font-size: 16px;
    font-weight: 800;
  }

  .form-group {
    margin-bottom: 10px;
  }

  .form-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  .type-toggle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 10px;
  }

  .type-btn {
    padding: 10px;
    border-radius: 12px;
    border: 1px solid var(--border-leather);
    background: var(--bg-card-alt);
    color: var(--text-main);
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    font-family: inherit;
  }

  .type-btn.active.expense {
    background: var(--danger);
    color: #fff;
    border-color: var(--danger);
  }

  .type-btn.active.income {
    background: var(--success);
    color: #fff;
    border-color: var(--success);
  }

  .primary-btn {
    width: 100%;
    padding: 12px;
    border-radius: 14px;
    border: none;
    background: var(--accent);
    color: var(--accent-text);
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    font-family: inherit;
    margin-top: 6px;
  }

  .secondary-btn {
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid var(--border-leather);
    background: var(--bg-card-alt);
    color: var(--text-main);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
  }

  .danger-btn {
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid var(--danger);
    background: rgba(192, 57, 43, 0.1);
    color: var(--danger);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
  }

  /* Theme Swatches */
  .theme-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .theme-swatch {
    border: 2px solid var(--border-leather);
    border-radius: 12px;
    padding: 8px 6px;
    text-align: center;
    cursor: pointer;
    background: var(--bg-card-alt);
    font-size: 11px;
    font-weight: 700;
    font-family: inherit;
    color: var(--text-main);
  }

  .theme-swatch.active {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-soft);
  }

  .swatch-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    margin: 0 auto 4px;
    border: 1px dashed rgba(255, 255, 255, 0.65);
  }

  /* Emoji Picker */
  .emoji-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
    max-height: 150px;
    overflow-y: auto;
    padding: 6px;
    background: var(--input-bg);
    border-radius: 12px;
    border: 1px solid var(--border-leather);
  }

  .emoji-btn {
    font-size: 18px;
    padding: 6px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: none;
    cursor: pointer;
  }

  .emoji-btn.selected {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  /* PIN Lock Screen */
  .pin-overlay {
    position: fixed;
    inset: 0;
    background: var(--bg-app);
    z-index: 100;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
  }

  .pin-overlay.open {
    display: flex;
  }

  .pin-dots {
    display: flex;
    gap: 14px;
    margin: 20px 0;
  }

  .pin-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--accent);
  }

  .pin-dot.filled {
    background: var(--accent);
  }

  .keypad {
    display: grid;
    grid-template-columns: repeat(3, 72px);
    gap: 12px;
    margin-top: 8px;
  }

  .key-btn {
    height: 58px;
    border-radius: 16px;
    border: 1px solid var(--border-leather);
    background: var(--bg-card);
    color: var(--text-main);
    font-size: 20px;
    font-weight: 800;
    cursor: pointer;
    font-family: inherit;
  }

  .toast {
    position: fixed;
    top: 74px;
    left: 50%;
    transform: translateX(-50%);
    background: #231d18;
    color: #fff;
    padding: 9px 16px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    z-index: 90;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    white-space: nowrap;
    max-width: 90%;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }

  .toast.show {
    opacity: 1;
  }

  .empty-state {
    text-align: center;
    padding: 36px 16px;
    color: var(--text-muted);
    font-size: 13px;
  }

  .settings-card {
    padding: 16px;
    margin-bottom: 14px;
  }

  .settings-card h3 {
    font-size: 13px;
    font-weight: 800;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
</head>
<body>

<div class="wallet-chassis" id="appChassis">
  <!-- Toast Banner -->
  <div class="toast" id="toastBanner"></div>

  <!-- PIN Lock Overlay -->
  <div class="pin-overlay" id="pinOverlay">
    <svg width="56" height="56" viewBox="0 0 64 64" fill="none">
      <defs>
        <linearGradient id="bronzeGradPin" x1="0" y1="0" x2="64" y2="64">
          <stop offset="0%" stop-color="#e3b07a"/>
          <stop offset="50%" stop-color="#a8642c"/>
          <stop offset="100%" stop-color="#5e3210"/>
        </linearGradient>
      </defs>
      <rect x="4" y="4" width="56" height="56" rx="16" fill="url(#bronzeGradPin)" stroke="#f6d5b0" stroke-width="2"/>
