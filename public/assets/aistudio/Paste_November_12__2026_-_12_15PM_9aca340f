                </select>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div class="leather-card settings-card">
            <div class="leather-card-inner">
              <h3>${t('syncTitle')}</h3>
              <p style="font-size:12px;color:var(--text-muted);margin-bottom:8px;">${t('syncDesc')}</p>
              <input class="input-field" id="syncPassInput" type="password" placeholder="${t('syncPass')}" style="margin-bottom:8px;" />
              <div class="grid-2">
                <button class="primary-btn" style="margin-top:0;" onclick="exportEncryptedSync()">${t('saveEncFile')}</button>
                <button class="secondary-btn" onclick="document.getElementById('encSyncFile').click()">${t('loadEncFile')}</button>
              </div>
              <input type="file" id="encSyncFile" accept=".balatec,.json" style="display:none;" onchange="importEncryptedSync(event)" />
            </div>
