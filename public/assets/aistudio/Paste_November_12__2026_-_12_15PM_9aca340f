  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return defaultState();
      const parsed = JSON.parse(raw);
      if (parsed.currency === 'FCFA') parsed.currency = 'CFA';
      if (Array.isArray(parsed.transactions)) {
        parsed.transactions.forEach(tx => { if (tx.currency === 'FCFA') tx.currency = 'CFA'; });
      }
      return Object.assign(defaultState(), parsed);
    } catch (e) {
      return memoryFallback || defaultState();
    }
  }

  let state = loadState();
  let activeTab = 'ledger';
  let ledgerFilters = { query: '', type: 'all', category: 'all' };
  let pinBuffer = '';

  function saveState() {
    memoryFallback = state;
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch (e) {
      showToast('Session storage mode active');
    }
  }

  function t(key) {
    return (I18N[state.lang] && I18N[state.lang][key]) || I18N.en[key] || key;
  }

  function itemName(item) {
    if (!item) return '';
    return state.lang === 'fr' ? (item.fr || item.en) : (item.en || item.fr);
  }

  function formatMoney(amount, currCode) {
    const code = (currCode || state.currency || 'USD') === 'FCFA' ? 'CFA' : (currCode || state.currency || 'USD');
    const cObj = CURRENCIES.find(c => c.code === code) || CURRENCIES[0];
    const num = Number(amount || 0);
    const formatted = code === 'CFA'
      ? Math.round(num).toLocaleString('en-US')
      : num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    return cObj.suffix ? `${formatted} ${cObj.symbol}` : `${cObj.symbol}${formatted}`;
  }

  function applyThemeAndFont() {
    const chassis = document.getElementById('appChassis');
    const themeObj = THEMES[state.theme] || THEMES.white_leather;
    Object.entries(themeObj.vars).forEach(([k, v]) => chassis.style.setProperty(k, v));
    const fontObj = FONTS.find(f => f.id === state.font) || FONTS[0];
    chassis.style.setProperty('--active-font', fontObj.stack);
    document.body.style.fontFamily = fontObj.stack;
  }

  function showToast(msg) {
    const el = document.getElementById('toastBanner');
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(el._timer);
    el._timer = setTimeout(() => el.classList.remove('show'), 2600);
  }

  function updateChromeLabels() {
    document.getElementById('brandSub').textContent = t('sub');
    document.getElementById('langToggleBtn').textContent = state.lang === 'en' ? 'FR' : 'EN';
    document.getElementById('currencyBadge').textContent = state.currency;
    document.getElementById('navOverview').textContent = t('overview');
    document.getElementById('navAccounts').textContent = t('accounts');
    document.getElementById('navLedger').textContent = t('ledger');
    document.getElementById('navCategories').textContent = t('categories');
    document.getElementById('navSettings').textContent = t('settings');
    document.getElementById('fabLabel').textContent = t('newEntry');

    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.tab === activeTab);
    });
  }

  window.switchTab = function(tab) {
    activeTab = tab;
    updateChromeLabels();
    renderMain();
  };

  window.toggleLanguage = function() {
    state.lang = state.lang === 'en' ? 'fr' : 'en';
    if (state.lang === 'fr') state.currency = 'CFA';
    saveState();
    updateChromeLabels();
    renderMain();
  };

  window.cycleCurrency = function() {
    const idx = CURRENCIES.findIndex(c => c.code === state.currency);
    state.currency = CURRENCIES[(idx + 1) % CURRENCIES.length].code;
    saveState();
    updateChromeLabels();
    renderMain();
  };

  function computeTotals(txs) {
    let income = 0, expense = 0;
    txs.forEach(tx => {
      if (tx.type === 'income') income += Number(tx.amount || 0);
      else expense += Number(tx.amount || 0);
    });
    const initialSum = state.accounts.reduce((acc, a) => acc + Number(a.initial || 0), 0);
    return { income, expense, net: initialSum + income - expense };
  }

  function accountBalance(accId) {
    const acc = state.accounts.find(a => a.id === accId);
    let bal = acc ? Number(acc.initial || 0) : 0;
    state.transactions.forEach(tx => {
      if (tx.accountId === accId) {
        bal += tx.type === 'income' ? Number(tx.amount || 0) : -Number(tx.amount || 0);
      }
    });
    return bal;
  }

  function sortedAccounts() {
    const order = { Cash: 1, Card: 2, Savings: 3, Custom: 4 };
    return [...state.accounts].sort((a, b) => (order[a.type] || 9) - (order[b.type] || 9));
  }

  function renderTxItem(tx) {
    const cat = state.categories.find(c => c.id === tx.categoryId) || state.categories[0];
    const acc = state.accounts.find(a => a.id === tx.accountId) || state.accounts[0];
    const title = tx.payee || itemName(cat);
    const sign = tx.type === 'income' ? '+' : '-';
    return `
      <div class="tx-item">
        <div class="tx-left">
          <div class="tx-icon">${cat ? cat.icon : '💸'}</div>
          <div class="tx-info">
            <div class="tx-title">${escapeHtml(title)}</div>
            <div class="tx-meta">${escapeHtml(itemName(acc))} • ${escapeHtml(itemName(cat))} • ${tx.date}</div>
          </div>
        </div>
        <div class="tx-right">
          <div class="tx-amount ${tx.type}">${sign}${formatMoney(tx.amount, tx.currency)}</div>
          <button class="tx-del" onclick="deleteTx('${tx.id}')">${t('delete')}</button>
        </div>
      </div>
    `;
  }

  function escapeHtml(str) {
    return String(str || '').replace(/[&<>"']/g, s => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[s]));
  }

