              <div style="display:flex;flex-direction:column;gap:8px;">
                <button class="primary-btn" style="margin-top:0;" onclick="exportStatement()">${t('exportStmt')}</button>
                <div class="grid-2">
                  <button class="secondary-btn" onclick="exportCSV()">${t('exportCsv')}</button>
                  <button class="secondary-btn" onclick="exportJSON()">${t('exportJson')}</button>
                </div>
                <button class="secondary-btn" onclick="document.getElementById('importDataFile').click()">${t('importFile')}</button>
                <input type="file" id="importDataFile" accept=".json,.csv,.html" style="display:none;" onchange="handleGeneralImport(event)" />
              </div>
            </div>
          </div>

          <div class="leather-card settings-card">
            <div class="leather-card-inner">
              <h3>${t('securityTitle')}</h3>
              <div style="display:flex;gap:8px;margin-bottom:10px;">
                <input class="input-field" id="newPinInput" type="password" maxlength="4" inputmode="numeric" placeholder="4-digit PIN" />
                <button class="secondary-btn" onclick="saveNewPin()">${t('setPin')}</button>
                <button class="secondary-btn" onclick="clearPin()">${t('clearPin')}</button>
              </div>
              <div class="grid-2">
                <button class="danger-btn" onclick="clearLedgerData()">${t('clearLedger')}</button>
                <button class="danger-btn" onclick="resetAllData()">${t('resetAll')}</button>
              </div>
            </div>
          </div>
        </div>
      </div>`;
    }
  }

  /* Filters & Settings Handlers */
  window.updateSearch = function(val) { ledgerFilters.query = val; renderMain(); };
  window.updateTypeFilter = function(val) { ledgerFilters.type = val; renderMain(); };
  window.updateCatFilter = function(val) { ledgerFilters.category = val; renderMain(); };
  window.filterByCategory = function(catId) {
    ledgerFilters.category = catId;
    switchTab('ledger');
  };

  window.setTheme = function(id) { state.theme = id; saveState(); applyThemeAndFont(); renderMain(); };
  window.setLang = function(val) {
    state.lang = val;
    if (val === 'fr') state.currency = 'CFA';
    saveState(); updateChromeLabels(); renderMain();
  };
  window.setFont = function(val) { state.font = val; saveState(); applyThemeAndFont(); renderMain(); };
  window.setCurrency = function(val) { state.currency = val; saveState(); updateChromeLabels(); renderMain(); };

  /* Transaction Modal */
  let modalTxType = 'expense';

  window.openTxModal = function() {
    modalTxType = 'expense';
    const today = new Date().toISOString().slice(0, 10);
    const modal = document.getElementById('modalContent');
    modal.innerHTML = `
      <div class="modal-head">
        <span class="modal-title">${t('addTx')}</span>
        <button class="pill-btn" onclick="closeModal()">✕</button>
      </div>
      <div class="type-toggle">
        <button type="button" class="type-btn active expense" id="btnTypeExp" onclick="setTxType('expense')">${t('expense')}</button>
        <button type="button" class="type-btn income" id="btnTypeInc" onclick="setTxType('income')">${t('income')}</button>
      </div>
      <div class="grid-2">
        <div class="form-group">
          <label class="form-label">${t('amount')}</label>
          <input class="input-field" id="txAmount" type="number" step="any" placeholder="0.00" />
        </div>
        <div class="form-group">
          <label class="form-label">${t('currency')}</label>
          <select class="select-field" id="txCurrency">
            ${CURRENCIES.map(c => `<option value="${c.code}" ${state.currency === c.code ? 'selected' : ''}>${c.code}</option>`).join('')}
          </select>
        </div>
