      <div class="grid-2">
        <div class="form-group">
          <label class="form-label">${t('account')}</label>
          <select class="select-field" id="txAccount" onchange="checkPriorityTrigger()">
            ${sortedAccounts().map(a => `<option value="${a.id}">${a.icon} ${escapeHtml(itemName(a))}</option>`).join('')}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">${t('category')}</label>
          <select class="select-field" id="txCategory" onchange="checkPriorityTrigger()">
            ${state.categories.map(c => `<option value="${c.id}">${c.icon} ${escapeHtml(itemName(c))}</option>`).join('')}
          </select>
        </div>
      </div>
      <div class="form-group" id="presetPayeeGroup" style="display:none;">
        <label class="form-label">${t('payee')} (Auto-CFA)</label>
        <select class="select-field" id="txPresetPayee" onchange="applyPresetPayee(this.value)">
          <option value="">${t('selectPayee')}</option>
          ${PRESET_PAYEES.map(p => `<option value="${escapeHtml(p)}">${escapeHtml(p)}</option>`).join('')}
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">${t('payee')}</label>
        <input class="input-field" id="txPayee" type="text" placeholder="${t('customPayee')}" />
      </div>
      <div class="grid-2">
        <div class="form-group">
          <label class="form-label">${t('date')}</label>
          <input class="input-field" id="txDate" type="date" value="${today}" />
        </div>
        <div class="form-group">
          <label class="form-label">${t('note')}</label>
          <input class="input-field" id="txNote" type="text" placeholder="..." />
        </div>
      </div>
      <button class="primary-btn" onclick="submitTransaction()">${t('saveTx')}</button>
    `;
    document.getElementById('modalBackdrop').classList.add('open');
    checkPriorityTrigger();
  };

  window.setTxType = function(type) {
    modalTxType = type;
    document.getElementById('btnTypeExp').className = `type-btn expense ${type === 'expense' ? 'active' : ''}`;
    document.getElementById('btnTypeInc').className = `type-btn income ${type === 'income' ? 'active' : ''}`;
  };

  window.checkPriorityTrigger = function() {
    const accId = document.getElementById('txAccount').value;
    const catId = document.getElementById('txCategory').value;
    const acc = state.accounts.find(a => a.id === accId);
    const cat = state.categories.find(c => c.id === catId);
    const isPriority = (acc && acc.priority) || (cat && cat.priority);
    const payeeGroup = document.getElementById('presetPayeeGroup');
    if (isPriority) {
      payeeGroup.style.display = 'block';
      document.getElementById('txCurrency').value = 'CFA';
    } else {
      payeeGroup.style.display = 'none';
    }
  };

  window.applyPresetPayee = function(val) {
    if (val) {
      document.getElementById('txPayee').value = val;
      document.getElementById('txCurrency').value = 'CFA';
    }
  };

  window.submitTransaction = function() {
    const amt = parseFloat(document.getElementById('txAmount').value);
    if (!amt || amt <= 0) {
      showToast('Enter a valid amount');
      return;
    }
    const tx = {
      id: 'tx_' + Date.now(),
      type: modalTxType,
      amount: amt,
      currency: document.getElementById('txCurrency').value,
      accountId: document.getElementById('txAccount').value,
      categoryId: document.getElementById('txCategory').value,
      payee: document.getElementById('txPayee').value.trim(),
      date: document.getElementById('txDate').value || new Date().toISOString().slice(0, 10),
      note: document.getElementById('txNote').value.trim()
    };
    state.transactions.unshift(tx);
    saveState();
    closeModal();
    renderMain();
    showToast('Transaction saved');
  };

  window.deleteTx = function(id) {
    state.transactions = state.transactions.filter(tx => tx.id !== id);
    saveState();
    renderMain();
  };

  /* Account Modal */
  window.openAccountModal = function(editId) {
    const existing = editId ? state.accounts.find(a => a.id === editId) : null;
    const modal = document.getElementById('modalContent');
    modal.innerHTML = `
      <div class="modal-head">
        <span class="modal-title">${existing ? t('editAccount') : t('newAccount')}</span>
        <button class="pill-btn" onclick="closeModal()">✕</button>
      </div>
      <div class="form-group">
        <label class="form-label">${t('accName')}</label>
        <input class="input-field" id="accNameInput" type="text" value="${existing ? escapeHtml(itemName(existing)) : ''}" />
      </div>
      <div class="grid-2">
        <div class="form-group">
          <label class="form-label">${t('accType')}</label>
          <select class="select-field" id="accTypeInput">
            ${['Cash', 'Card', 'Savings', 'Custom'].map(tp => `<option value="${tp}" ${existing && existing.type === tp ? 'selected' : ''}>${tp}</option>`).join('')}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">${t('initBal')}</label>
          <input class="input-field" id="accInitInput" type="number" step="any" value="${existing ? existing.initial : 0}" />
        </div>
      </div>
      <button class="primary-btn" onclick="saveAccount('${existing ? existing.id : ''}')">${t('save')}</button>
      ${existing ? `<button class="danger-btn" style="width:100%;margin-top:8px;" onclick="deleteAccount('${existing.id}')">${t('delete')}</button>` : ''}
    `;
    document.getElementById('modalBackdrop').classList.add('open');
  };

  window.saveAccount = function(editId) {
    const name = document.getElementById('accNameInput').value.trim();
    if (!name) return;
    const type = document.getElementById('accTypeInput').value;
    const initial = parseFloat(document.getElementById('accInitInput').value) || 0;
    if (editId) {
      const acc = state.accounts.find(a => a.id === editId);
      if (acc) {
        if (state.lang === 'fr') acc.fr = name; else acc.en = name;
        acc.type = type;
        acc.initial = initial;
      }
    } else {
      const icons = { Cash: '💵', Card: '💳', Savings: '🏦', Custom: '👛' };
      state.accounts.push({
        id: 'acc_' + Date.now(),
        icon: icons[type] || '👛',
        en: name, fr: name, type, priority: false, initial
      });
    }
    saveState();
    closeModal();
    renderMain();
  };

  window.deleteAccount = function(id) {
    if (state.accounts.length <= 1) return;
    state.accounts = state.accounts.filter(a => a.id !== id);
    saveState();
    closeModal();
    renderMain();
  };

  /* Category Modal */
  let selectedEmoji = '⭐';
  window.openCategoryModal = function() {
    selectedEmoji = '⭐';
    const modal = document.getElementById('modalContent');
    modal.innerHTML = `
      <div class="modal-head">
        <span class="modal-title">${t('newCategory')}</span>
        <button class="pill-btn" onclick="closeModal()">✕</button>
      </div>
      <div class="form-group">
        <label class="form-label">${t('catName')}</label>
        <input class="input-field" id="newCatName" type="text" />
      </div>
      <div class="form-group">
        <label class="form-label">${t('pickColor')}</label>
        <input class="input-field" id="newCatColor" type="color" value="#9c6635" style="height:40px;padding:4px;" />
      </div>
      <div class="form-group">
        <label class="form-label">${t('pickEmoji')} (36)</label>
        <div class="emoji-grid">
          ${EMOJI_CHOICES.map(em => `<button type="button" class="emoji-btn ${em === selectedEmoji ? 'selected' : ''}" onclick="pickEmoji(this, '${em}')">${em}</button>`).join('')}
        </div>
      </div>
      <button class="primary-btn" onclick="saveNewCategory()">${t('save')}</button>
    `;
    document.getElementById('modalBackdrop').classList.add('open');
  };

  window.pickEmoji = function(btn, em) {
    selectedEmoji = em;
    document.querySelectorAll('.emoji-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
  };

  window.saveNewCategory = function() {
    const name = document.getElementById('newCatName').value.trim();
    if (!name) return;
    state.categories.push({
      id: 'cat_' + Date.now(),
      icon: selectedEmoji,
      en: name, fr: name,
      color: document.getElementById('newCatColor').value,
      priority: false
    });
    saveState();
    closeModal();
    renderMain();
  };

  window.closeModal = function() {
    document.getElementById('modalBackdrop').classList.remove('open');
  };

  window.closeModalOnBg = function(e) {
    if (e.target.id === 'modalBackdrop') closeModal();
  };

  /* AES-256-GCM Multi-Device Encrypted Sync (.balatec) */
  async function deriveKey(passphrase, salt) {
    const enc = new TextEncoder();
    const keyMaterial = await crypto.subtle.importKey('raw', enc.encode(passphrase), 'PBKDF2', false, ['deriveKey']);
    return crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt, iterations: 100000, hash: 'SHA-256' },
      keyMaterial,
      { name: 'AES-GCM', length: 256 },
      false,
      ['encrypt', 'decrypt']
    );
  }

  window.exportEncryptedSync = async function() {
    const pass = document.getElementById('syncPassInput').value.trim();
    if (!pass) {
      showToast('Enter a sync encryption passphrase first');
      return;
    }
    try {
      const salt = crypto.getRandomValues(new Uint8Array(16));
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const key = await deriveKey(pass, salt);
      const plaintext = new TextEncoder().encode(JSON.stringify(state));
      const cipher = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, plaintext);
      const bundle = {
        app: 'BalatecSecureWallet',
        v: 9,
        salt: Array.from(salt),
        iv: Array.from(iv),
        data: Array.from(new Uint8Array(cipher))
      };
      downloadBlob(JSON.stringify(bundle), 'balatec_sync.balatec', 'application/json');
      showToast('Encrypted .balatec sync file ready');
    } catch (e) {
      showToast('Encryption error');
    }
  };

  window.importEncryptedSync = function(e) {
    const file = e.target.files[0];
    if (!file) return;
    const pass = document.getElementById('syncPassInput').value.trim();
    if (!pass) {
      showToast('Enter your sync passphrase first');
      return;
    }
    const reader = new FileReader();
    reader.onload = async function(ev) {
      try {
        const bundle = JSON.parse(ev.target.result);
        const salt = new Uint8Array(bundle.salt);
        const iv = new Uint8Array(bundle.iv);
        const data = new Uint8Array(bundle.data);
        const key = await deriveKey(pass, salt);
        const decrypted = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, data);
        const incoming = JSON.parse(new TextDecoder().decode(decrypted));
        mergeIncomingState(incoming);
        showToast('Merged encrypted sync file');
      } catch (err) {
        showToast('Invalid passphrase or sync file');
      }
    };
    reader.readAsText(file);
  };

  function mergeIncomingState(incoming) {
    if (!incoming) return;
    if (Array.isArray(incoming.accounts)) {
      const ids = new Set(state.accounts.map(a => a.id));
      incoming.accounts.forEach(a => { if (!ids.has(a.id)) state.accounts.push(a); });
    }
    if (Array.isArray(incoming.categories)) {
      const ids = new Set(state.categories.map(c => c.id));
      incoming.categories.forEach(c => { if (!ids.has(c.id)) state.categories.push(c); });
    }
    if (Array.isArray(incoming.transactions)) {
      const ids = new Set(state.transactions.map(tx => tx.id));
      incoming.transactions.forEach(tx => { if (!ids.has(tx.id)) state.transactions.push(tx); });
      state.transactions.sort((a, b) => (b.date || '').localeCompare(a.date || ''));
    }
    saveState();
    renderMain();
  }

  /* Export & Import Center */
  window.updateScopeFilterOptions = function() {
    const scope = document.getElementById('exportScope').value;
    const wrap = document.getElementById('exportScopeValueWrap');
    const sel = document.getElementById('exportScopeValue');
    if (scope === 'all') {
      wrap.style.display = 'none';
      return;
    }
    wrap.style.display = 'block';
    if (scope === 'payee') {
      const payees = [...new Set(state.transactions.map(tx => tx.payee).filter(Boolean))];
      sel.innerHTML = payees.map(p => `<option value="${escapeHtml(p)}">${escapeHtml(p)}</option>`).join('');
    } else if (scope === 'account') {
      sel.innerHTML = state.accounts.map(a => `<option value="${a.id}">${escapeHtml(itemName(a))}</option>`).join('');
    } else if (scope === 'category') {
      sel.innerHTML = state.categories.map(c => `<option value="${c.id}">${escapeHtml(itemName(c))}</option>`).join('');
    }
  };

  function getScopedTransactions() {
    const scopeEl = document.getElementById('exportScope');
    if (!scopeEl || scopeEl.value === 'all') return state.transactions;
    const scope = scopeEl.value;
    const val = document.getElementById('exportScopeValue').value;
    return state.transactions.filter(tx => {
      if (scope === 'payee') return tx.payee === val;
      if (scope === 'account') return tx.accountId === val;
      if (scope === 'category') return tx.categoryId === val;
      return true;
    });
  }

  function downloadBlob(content, filename, mime) {
    const blob = new Blob([content], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  window.exportJSON = function() {
    const payload = Object.assign({}, state, { transactions: getScopedTransactions() });
    downloadBlob(JSON.stringify(payload, null, 2), 'balatec_wallet_backup.json', 'application/json');
    showToast('JSON exported');
  };

  window.exportCSV = function() {
    const txs = getScopedTransactions();
    const header = 'id,date,type,amount,currency,accountId,categoryId,payee,note\n';
    const rows = txs.map(tx => [
      tx.id, tx.date, tx.type, tx.amount, tx.currency, tx.accountId, tx.categoryId,
      `"${String(tx.payee || '').replace(/"/g, '""')}"`,
      `"${String(tx.note || '').replace(/"/g, '""')}"`
    ].join(',')).join('\n');
    downloadBlob(header + rows, 'balatec_ledger.csv', 'text/csv');
    showToast('CSV exported');
  };

  window.exportStatement = function() {
    const txs = getScopedTransactions();
    const totals = computeTotals(txs);
    const backupB64 = btoa(unescape(encodeURIComponent(JSON.stringify(state))));
    const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Balatec Statement</title>
    <style>body{font-family:Arial,sans-serif;padding:28px;color:#222;}h1{color:#8c5323;}
    table{width:100%;border-collapse:collapse;margin-top:16px;}th,td{border:1px solid #ccc;padding:8px;font-size:12px;text-align:left;}
    th{background:#f4ece4;}</style></head><body>
    <h1>BALATEC SECURE WALLET — A4 FINANCIAL STATEMENT</h1>
    <p>Income: ${formatMoney(totals.income)} | Expenses: ${formatMoney(totals.expense)} | Net: ${formatMoney(totals.net)}</p>
    <table><thead><tr><th>Date</th><th>Type</th><th>Payee</th><th>Account</th><th>Category</th><th>Amount</th></tr></thead>
    <tbody>${txs.map(tx => {
      const a = state.accounts.find(x => x.id === tx.accountId);
      const c = state.categories.find(x => x.id === tx.categoryId);
      return `<tr><td>${tx.date}</td><td>${tx.type}</td><td>${escapeHtml(tx.payee)}</td><td>${escapeHtml(itemName(a))}</td><td>${escapeHtml(itemName(c))}</td><td>${formatMoney(tx.amount, tx.currency)}</td></tr>`;
    }).join('')}</tbody></table>
    <!-- BALATEC_BACKUP:${backupB64} -->
    </body></html>`;
    downloadBlob(html, 'balatec_statement_A4.html', 'text/html');
    showToast('A4 Statement exported');
  };

  window.handleGeneralImport = function(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(ev) {
      const text = ev.target.result;
      try {
        if (file.name.endsWith('.json')) {
          mergeIncomingState(JSON.parse(text));
          showToast('JSON imported & merged');
        } else if (file.name.endsWith('.html')) {
          const match = text.match(/BALATEC_BACKUP:([A-Za-z0-9+/=]+)/);
          if (match) {
            const decoded = JSON.parse(decodeURIComponent(escape(atob(match[1]))));
            mergeIncomingState(decoded);
            showToast('Statement backup restored');
          }
        } else if (file.name.endsWith('.csv')) {
          const lines = text.trim().split(/\r?\n/).slice(1);
          lines.forEach((line, i) => {
            const cols = line.split(',');
            if (cols.length >= 5) {
              state.transactions.push({
                id: cols[0] || ('tx_imp_' + Date.now() + i),
                date: cols[1] || new Date().toISOString().slice(0, 10),
                type: cols[2] === 'income' ? 'income' : 'expense',
                amount: parseFloat(cols[3]) || 0,
                currency: cols[4] || state.currency,
                accountId: cols[5] || state.accounts[0].id,
                categoryId: cols[6] || state.categories[0].id,
                payee: (cols[7] || '').replace(/^"|"$/g, ''),
                note: (cols[8] || '').replace(/^"|"$/g, '')
              });
            }
          });
          saveState();
          renderMain();
          showToast('CSV imported');
        }
      } catch (err) {
        showToast('Import failed');
      }
    };
    reader.readAsText(file);
  };

  /* PIN Security & Maintenance */
  function buildKeypad() {
    const pad = document.getElementById('pinKeypad');
    const keys = ['1','2','3','4','5','6','7','8','9','C','0','⌫'];
    pad.innerHTML = keys.map(k => `<button class="key-btn" onclick="pressPinKey('${k}')">${k}</button>`).join('');
  }

  window.pressPinKey = function(k) {
    if (k === 'C') pinBuffer = '';
    else if (k === '⌫') pinBuffer = pinBuffer.slice(0, -1);
    else if (pinBuffer.length < 4) pinBuffer += k;

    document.querySelectorAll('#pinDots .pin-dot').forEach((dot, idx) => {
      dot.classList.toggle('filled', idx < pinBuffer.length);
    });

    if (pinBuffer.length === 4) {
      if (pinBuffer === state.pin) {
        pinBuffer = '';
        document.getElementById('pinOverlay').classList.remove('open');
      } else {
        showToast('Incorrect PIN');
        pinBuffer = '';
        setTimeout(() => {
          document.querySelectorAll('#pinDots .pin-dot').forEach(d => d.classList.remove('filled'));
        }, 200);
      }
    }
  };

  window.saveNewPin = function() {
    const val = document.getElementById('newPinInput').value.trim();
    if (!/^\d{4}$/.test(val)) {
      showToast('Enter exactly 4 digits');
      return;
    }
    state.pin = val;
    saveState();
    document.getElementById('newPinInput').value = '';
    showToast('4-digit PIN activated');
  };

  window.clearPin = function() {
    state.pin = '';
    saveState();
    showToast('PIN disabled');
  };

  window.lockNow = function() {
    if (!state.pin) {
      showToast('Set a 4-digit PIN in Settings first');
      return;
    }
    pinBuffer = '';
    document.querySelectorAll('#pinDots .pin-dot').forEach(d => d.classList.remove('filled'));
    document.getElementById('pinOverlay').classList.add('open');
  };

  window.clearLedgerData = function() {
    if (!confirm(t('confirmClear'))) return;
    state.transactions = [];
    saveState();
    renderMain();
    showToast('Ledger cleared');
  };

  window.resetAllData = function() {
    if (!confirm(t('confirmReset'))) return;
    state = defaultState();
    saveState();
    applyThemeAndFont();
    updateChromeLabels();
    renderMain();
    showToast('Wallet reset to defaults');
  };

  /* Init */
  buildKeypad();
  applyThemeAndFont();
  updateChromeLabels();
  if (state.pin) {
    document.getElementById('pinOverlay').classList.add('open');
  }
  renderMain();
})();
</script>
