          <div class="leather-card settings-card">
            <div class="leather-card-inner">
              <h3>${t('exportCenter')}</h3>
              <div class="form-group">
                <label class="form-label">${t('scope')}</label>
                <select class="select-field" id="exportScope" onchange="updateScopeFilterOptions()">
                  <option value="all">${t('scopeAll')}</option>
                  <option value="payee">${t('scopePayee')}</option>
                  <option value="account">${t('scopeAccount')}</option>
